# Required for Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
GROQ_API_KEY=your_groq_api_key

# Optional fallback when Groq is rate-limited
OPENAI_API_KEY=sk-your-openai-key

# AAOS tuning
AAOS_DATA_DIR=./data
AAOS_MODEL_PRIMARY=llama-3.3-70b-versatile
AAOS_MODEL_FALLBACKS=llama-3.1-8b-instant,gpt-4o-mini
AAOS_HISTORY_LIMIT=8
AAOS_MAX_TOOL_ROUNDS=5
AAOS_MAX_TOKENS=1024

# HTTP API: if set, require Authorization: Bearer <token>
AAOS_API_TOKEN=

# Route Telegram/HTTP through Supervisor profiles
AAOS_USE_SUPERVISOR=false
